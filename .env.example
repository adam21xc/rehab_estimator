# Copy to .env and supply values privately. Never commit .env.
# Required for the existing Supabase workspace and dashboards.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
REHAB_ALLOWED_EMAILS=you@example.com
FROM_EMAIL=you@example.com

# Optional: remodel rendering. Requests can incur usage charges.
OPENAI_API_KEY=

# Optional: Gmail outreach and OAuth setup.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5173/api/oauth/callback
GMAIL_REFRESH_TOKEN=
SENDING_NAME=
PUBLIC_BASE_DOMAIN=http://localhost:5173
SEND_DUE_SECRET=
SCAN_REPLIES_SECRET=

# Optional: Twilio SMS. Configure a sender before use.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
SMS_PUBLIC_BASE_URL=
